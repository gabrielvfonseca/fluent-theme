			"settings": {
				"fontStyle": "underline",
				"foreground": "#60a5fa"
			}
		},
		{
			"name": "Decorators",
			"scope": [
				"tag.decorator.js entity.name.tag.js",
				"tag.decorator.js punctuation.definition.tag.js"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#60a5fa"
			}
		},
