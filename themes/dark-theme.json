				"variable.other.class.js"
			],
			"settings": {
				"foreground": "#999999"
			}
		},
		{
			"name": "Language methods",
			"scope": [
				"variable.language"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#999999"
